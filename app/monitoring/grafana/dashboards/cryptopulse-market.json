    {
      "id": 11,
      "type": "timeseries",
      "title": "Performance comparee (base 100)",
      "description": "Evolution relative des cryptos sur la periode, base 100 au debut de la fenetre.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cryptopulse-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cryptopulse-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT snapshot_ts AS time, coin_id AS metric,\n       price_usd / first_value(price_usd) OVER (PARTITION BY coin_id ORDER BY snapshot_ts) * 100 AS value\nFROM raw.prices\nWHERE $__timeFilter(snapshot_ts) AND coin_id IN ($coins)\nORDER BY 1"
        }
