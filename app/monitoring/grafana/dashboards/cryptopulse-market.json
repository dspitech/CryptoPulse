          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT price_date::timestamp AS time, close_usd AS \"Cloture\"\nFROM marts.fct_daily_prices\nWHERE coin_id = '${coin}' AND $__timeFilter(price_date::timestamp)\nORDER BY 1"
