            "uid": "cryptopulse-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT price_date::timestamp AS time,\n       open_usd AS open, high_usd AS high, low_usd AS low, close_usd AS close,\n       volume_24h_usd AS volume\nFROM marts.fct_daily_prices\nWHERE coin_id = '${coin}' AND $__timeFilter(price_date::timestamp)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
