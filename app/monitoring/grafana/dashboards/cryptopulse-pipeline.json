    {
      "id": 17,
      "type": "table",
      "title": "Derniers controles qualite",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cryptopulse-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cryptopulse-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT run_at AS \"Date\", check_name AS \"Controle\", status AS \"Statut\",\n       metric AS \"Metrique\", details AS \"Details\"\nFROM ops.quality_runs\nORDER BY run_at DESC\nLIMIT 25"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Statut"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      },
                      "WARNING": {
                        "text": "WARNING",
                        "color": "orange",
                        "index": 1
                      },
                      "FAIL": {
                        "text": "FAIL",
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
