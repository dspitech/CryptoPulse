    {
      "id": 10,
      "type": "table",
      "title": "Titres recents et leur sentiment",
      "description": "Seuls le titre, le lien et le score sont conserves ; cliquez sur un titre pour ouvrir l'article.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cryptopulse-pg"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cryptopulse-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT published_at AS \"Publie\", coin_id AS \"Crypto\", source AS \"Source\", title AS \"Titre\",\n       label AS \"Sentiment\", sentiment AS \"Score\", link AS \"Lien\"\nFROM staging.stg_news\nORDER BY published_at DESC\nLIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Sentiment"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "positive": {
                        "text": "positif",
                        "color": "green",
                        "index": 0
                      },
                      "negative": {
                        "text": "negatif",
                        "color": "red",
                        "index": 1
                      },
                      "neutral": {
                        "text": "neutre",
                        "color": "text",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Score"
            },
            "properties": [
