          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT published_date::timestamp AS time, coin_id AS metric, avg_sentiment AS value\nFROM marts.fct_daily_sentiment\nWHERE $__timeFilter(published_date::timestamp) AND coin_id IN ($coins)\nORDER BY 1"
