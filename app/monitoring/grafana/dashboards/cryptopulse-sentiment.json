    {
      "id": 8,
      "type": "timeseries",
      "title": "Prix et sentiment",
      "description": "Mise en regard du cours de cloture (axe de gauche) et du sentiment des actualites (axe de droite). Une correlation visuelle n'implique pas une causalite.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cryptopulse-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cryptopulse-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT d.price_date::timestamp AS time, d.close_usd AS \"Cloture\", s.avg_sentiment AS \"Sentiment\"\nFROM marts.fct_daily_prices d\nLEFT JOIN marts.fct_daily_sentiment s ON s.coin_id = d.coin_id AND s.published_date = d.price_date\nWHERE d.coin_id = '${coin}' AND $__timeFilter(d.price_date::timestamp)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
